/**
 * dashboard.ts — Local web dashboard for live bot monitoring
 *
 * Serves a browser UI at http://localhost:3001 showing:
 *   - Live PnL, trade status, position info
 *   - Today's trade log
 *   - Daily summary stats
 *
 * Run alongside the bot:
 *   npx ts-node src/dashboard.ts
 *
 * The bot writes state to trade-state.json and trades to trades.json
 * The dashboard reads those files every 3 seconds and serves fresh data.
 */

import express from "express";
import fs from "fs";
import path from "path";

const app  = express();
const PORT = 3001;

// ── Read helpers ─────────────────────────────────────────
function readJSON(file: string, fallback: any = null) {
  try {
    if (!fs.existsSync(file)) return fallback;
    return JSON.parse(fs.readFileSync(file, "utf-8"));
  } catch {
    return fallback;
  }
}

function getTodayIST(): string {
  return new Date().toLocaleDateString("en-CA", { timeZone: "Asia/Kolkata" });
}

// ── API endpoints ─────────────────────────────────────────
app.get("/api/status", (_req, res) => {
  const state  = readJSON("trade-state.json", {});
  const trades: any[] = readJSON("trades.json", []);
  const today  = getTodayIST();
  const todayTrades = trades.filter(t => t.date?.startsWith(today));

  const wins     = todayTrades.filter((t: any) => t.pnl > 0).length;
  const losses   = todayTrades.filter((t: any) => t.pnl <= 0).length;
  const totalPnl = todayTrades.reduce((s: number, t: any) => s + (t.pnl ?? 0), 0);

  let maxDD = 0, eq = 0, peak = 0;
  for (const t of todayTrades) {
    eq += t.pnl ?? 0;
    if (eq > peak) peak = eq;
    const dd = peak - eq;
    if (dd > maxDD) maxDD = dd;
  }

  res.json({
    timestamp: new Date().toLocaleString("en-IN", { timeZone: "Asia/Kolkata" }),
    activeState: state,
    todaySummary: { trades: todayTrades.length, wins, losses, totalPnl, maxDD },
    recentTrades: todayTrades.slice(-10).reverse(),
  });
});

// ── Heartbeat API (Amina + legacy) ────────────────────────
app.get("/api/heartbeat", (_req, res) => {
  const hb = readJSON("bot-heartbeat.json", null);
  res.json(hb ?? { error: "No heartbeat file yet" });
});

// ── Dashboard HTML ────────────────────────────────────────
app.get("/", (_req, res) => {
  res.send(`<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BANKNIFTY Bot Dashboard</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', sans-serif; background: #0d1117; color: #e6edf3; min-height: 100vh; }
    header { background: #161b22; padding: 16px 28px; border-bottom: 1px solid #30363d; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; }
    header h1 { font-size: 1.2rem; font-weight: 600; letter-spacing: 1px; }
    #strategy-badge { font-size: 0.75rem; padding: 3px 10px; border-radius: 20px; background: #1f4620; color: #3fb950; font-weight: 700; letter-spacing: 1px; }
    #clock { font-size: 0.85rem; color: #8b949e; }
    #status-dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: #3fb950; margin-right: 8px; animation: pulse 1.5s infinite; }
    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.4} }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 14px; padding: 20px 28px 0; }
    .card { background: #161b22; border: 1px solid #30363d; border-radius: 8px; padding: 16px 18px; }
    .card-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px; color: #8b949e; margin-bottom: 5px; }
    .card-value { font-size: 1.6rem; font-weight: 700; }
    .green { color: #3fb950; }
    .red   { color: #f85149; }
    .gray  { color: #8b949e; }
    .yellow{ color: #e3b341; }
    .cyan  { color: #58a6ff; }
    section { padding: 20px 28px; }
    section h2 { font-size: 0.82rem; text-transform: uppercase; letter-spacing: 1px; color: #8b949e; margin-bottom: 12px; }
    table { width: 100%; border-collapse: collapse; font-size: 0.82rem; }
    th { text-align: left; padding: 8px 10px; background: #161b22; color: #8b949e; border-bottom: 1px solid #30363d; font-weight: 500; }
    td { padding: 8px 10px; border-bottom: 1px solid #21262d; }
    tr:last-child td { border-bottom: none; }
    .badge { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 0.72rem; font-weight: 600; }
    .badge-ce   { background: #1f4620; color: #3fb950; }
    .badge-pe   { background: #3d1616; color: #f85149; }
    .badge-flat { background: #1c2128; color: #8b949e; }
    .badge-scanning { background: #1c2b3a; color: #58a6ff; }
    .badge-done { background: #2d2208; color: #e3b341; }
    #pos-box { background: #161b22; border: 1px solid #30363d; border-radius: 8px; padding: 20px 24px; margin: 0 28px 16px; }
    #pos-box h2 { font-size: 0.82rem; text-transform: uppercase; letter-spacing: 1px; color: #8b949e; margin-bottom: 12px; }
    /* Amina panels */
    .amina-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin: 0 28px 16px; }
    @media (max-width: 640px) { .amina-grid { grid-template-columns: 1fr; } }
    .amina-panel { background: #161b22; border: 1px solid #30363d; border-radius: 8px; padding: 16px 20px; }
    .amina-panel h3 { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 1px; color: #8b949e; margin-bottom: 12px; }
    .amina-row { display: flex; justify-content: space-between; align-items: center; padding: 5px 0; border-bottom: 1px solid #21262d; font-size: 0.83rem; }
    .amina-row:last-child { border-bottom: none; }
    .amina-row .lbl { color: #8b949e; }
    .amina-row .val { font-weight: 600; }
    .pos-row { display: flex; gap: 32px; flex-wrap: wrap; }
    .pos-field label { font-size: 0.72rem; color: #8b949e; text-transform: uppercase; }
    .pos-field span  { font-size: 1rem; font-weight: 600; }
    footer { text-align: center; padding: 20px; color: #30363d; font-size: 0.75rem; }
    #status-text { font-size: 0.8rem; color: #8b949e; }
  </style>
</head>
<body>
  <header>
    <div style="display:flex;align-items:center;gap:12px">
      <h1><span id="status-dot"></span>BANKNIFTY Bot Dashboard</h1>
      <span id="strategy-badge">—</span>
    </div>
    <div style="display:flex;align-items:center;gap:16px">
      <span id="status-text">—</span>
      <span id="clock">—</span>
    </div>
  </header>

  <div class="grid">
    <div class="card">
      <div class="card-label">Day P&L (pts)</div>
      <div class="card-value" id="pnl-pts">—</div>
    </div>
    <div class="card">
      <div class="card-label">Day P&L (₹)</div>
      <div class="card-value" id="pnl-rs">—</div>
    </div>
    <div class="card">
      <div class="card-label">Live Price</div>
      <div class="card-value cyan" id="live-price">—</div>
    </div>
    <div class="card">
      <div class="card-label">Day Open</div>
      <div class="card-value gray" id="day-open">—</div>
    </div>
    <div class="card">
      <div class="card-label">Trades Today</div>
      <div class="card-value" id="tradeCount">—</div>
    </div>
    <div class="card">
      <div class="card-label">Phase</div>
      <div class="card-value" id="phase-val" style="font-size:1rem">—</div>
    </div>
  </div>

  <!-- Active Position -->
  <section>
    <div id="pos-box">
      <h2>Active Position</h2>
      <div class="pos-row" id="pos-detail">
        <div class="badge badge-flat">FLAT — No open position</div>
      </div>
    </div>
  </section>

  <!-- Amina T1 + Re-entry Panels -->
  <div class="amina-grid" id="amina-panels">
    <div class="amina-panel">
      <h3>T1 Trade</h3>
      <div id="t1-rows"><div style="color:#8b949e;font-size:0.82rem">No T1 yet today</div></div>
    </div>
    <div class="amina-panel">
      <h3>Re-entry Trade</h3>
      <div id="re-rows"><div style="color:#8b949e;font-size:0.82rem">No re-entry yet today</div></div>
    </div>
  </div>

  <!-- Trades table (legacy / other strategies) -->
  <section id="trades-section">
    <h2>Today's Trades</h2>
    <table>
      <thead>
        <tr>
          <th>Time (IST)</th><th>Type</th><th>Dir</th>
          <th>Entry</th><th>Exit</th><th>PnL</th><th>Exit Reason</th>
        </tr>
      </thead>
      <tbody id="trades-tbody">
        <tr><td colspan="7" style="color:#8b949e;text-align:center;padding:20px">No trades yet today</td></tr>
      </tbody>
    </table>
  </section>

  <footer>Auto-refreshes every 3 seconds &nbsp;·&nbsp; Amina Strategy — Rs 10,66,085 over 5 years ✅</footer>

  <script>
    function fmt(v, decimals = 0) {
      if (v == null) return '—';
      return (v >= 0 ? '+' : '') + parseFloat(v).toFixed(decimals);
    }
    function fmtRs(pts) {
      if (pts == null) return '—';
      const rs = pts * 15;
      return (rs >= 0 ? '+' : '') + 'Rs ' + Math.abs(rs).toFixed(0);
    }
    function clr(v) {
      return v > 0 ? 'green' : v < 0 ? 'red' : 'gray';
    }
    function dirBadge(dir) {
      if (!dir) return '<span class="badge badge-flat">—</span>';
      return dir === 'CE'
        ? '<span class="badge badge-ce">CE</span>'
        : '<span class="badge badge-pe">PE</span>';
    }
    function phaseBadge(phase) {
      if (!phase) return '<span class="badge badge-flat">—</span>';
      if (phase === 'SCANNING')       return '<span class="badge badge-scanning">SCANNING</span>';
      if (phase === 'IN_T1')          return '<span class="badge badge-ce">IN T1</span>';
      if (phase === 'IN_RE')          return '<span class="badge badge-pe">IN RE-ENTRY</span>';
      if (phase === 'DONE')           return '<span class="badge badge-done">DONE</span>';
      return \`<span class="badge badge-flat">\${phase}</span>\`;
    }

    async function refresh() {
      try {
        // Fetch heartbeat (Amina) and status (legacy)
        const [hbResp, stResp] = await Promise.all([
          fetch('/api/heartbeat'),
          fetch('/api/status'),
        ]);
        const hb = await hbResp.json();
        const d  = await stResp.json();

        document.getElementById('clock').textContent = d.timestamp;

        const isAmina = hb && hb.strategy === 'AMINA';

        // Strategy badge
        const badge = document.getElementById('strategy-badge');
        badge.textContent = hb?.strategy ?? '—';
        badge.style.background = isAmina ? '#1a2840' : '#1f4620';
        badge.style.color      = isAmina ? '#58a6ff' : '#3fb950';

        // Status text
        document.getElementById('status-text').textContent = hb?.status ?? '—';

        // Live price
        const price = hb?.price ?? hb?.livePrice ?? 0;
        document.getElementById('live-price').textContent = price ? price.toFixed(0) : '—';

        // Day open
        const dayOpen = hb?.dayOpen;
        document.getElementById('day-open').textContent = dayOpen ? dayOpen.toFixed(0) : '—';

        // Phase
        const phaseEl = document.getElementById('phase-val');
        phaseEl.innerHTML = phaseBadge(hb?.phase);

        // P&L — prefer Amina heartbeat
        let dayPts = 0, dayRs = 0;
        if (isAmina) {
          // live P&L from heartbeat
          dayPts = hb.dailyPnL ?? hb.dayPts ?? 0;
          dayRs  = dayPts * 15;
        } else {
          dayPts = d.todaySummary.totalPnl ?? 0;
          dayRs  = dayPts * 15;
        }
        const pnlPtsEl = document.getElementById('pnl-pts');
        const pnlRsEl  = document.getElementById('pnl-rs');
        pnlPtsEl.textContent = fmt(dayPts);
        pnlPtsEl.className   = 'card-value ' + clr(dayPts);
        pnlRsEl.textContent  = (dayRs >= 0 ? '+' : '') + 'Rs ' + Math.abs(dayRs).toFixed(0);
        pnlRsEl.className    = 'card-value ' + clr(dayRs);

        // Trade count
        document.getElementById('tradeCount').textContent = hb?.tradeCount ?? d.todaySummary.trades ?? 0;

        // ── Active position box ──────────────────────────────────────
        const posBox = document.getElementById('pos-detail');
        if (isAmina && hb.inTrade && hb.direction) {
          const liveUnreal = hb.unrealisedPnL ?? 0;
          posBox.innerHTML = \`
            <div class="pos-field"><label>Symbol</label><br><span>\${hb.tradeSymbol ?? '—'}</span></div>
            <div class="pos-field"><label>Direction</label><br><span class="\${hb.direction === 'CE' ? 'green' : 'red'}">\${hb.direction}</span></div>
            <div class="pos-field"><label>Entry</label><br><span>\${hb.entryPrice ?? '—'}</span></div>
            <div class="pos-field"><label>SL</label><br><span class="red">\${hb.sl ?? '—'}</span></div>
            <div class="pos-field"><label>Live P&L (pts)</label><br><span class="\${clr(liveUnreal)}">\${fmt(liveUnreal)}</span></div>
            <div class="pos-field"><label>Live P&L (₹)</label><br><span class="\${clr(liveUnreal)}">\${(liveUnreal >= 0 ? '+' : '') + 'Rs ' + Math.abs(liveUnreal * 15).toFixed(0)}</span></div>
          \`;
        } else if (!isAmina && d.activeState && (d.activeState.earlyEntryDone || d.activeState.mainEntryDone) && d.activeState.tradeDirection) {
          const st = d.activeState;
          posBox.innerHTML = \`
            <div class="pos-field"><label>Symbol</label><br><span>\${st.tradeSymbol ?? '—'}</span></div>
            <div class="pos-field"><label>Direction</label><br><span class="\${st.tradeDirection === 'CE' ? 'green' : 'red'}">\${st.tradeDirection}</span></div>
            <div class="pos-field"><label>Entry ₹</label><br><span>\${st.entryPrice}</span></div>
            <div class="pos-field"><label>Daily PnL (pts)</label><br><span class="\${clr(st.dailyPnL)}">\${fmt(st.dailyPnL ?? 0)}</span></div>
          \`;
        } else {
          posBox.innerHTML = '<div class="badge badge-flat">FLAT — No open position</div>';
        }

        // ── Amina T1 panel ───────────────────────────────────────────
        const t1Rows = document.getElementById('t1-rows');
        if (isAmina && hb.t1Dir) {
          const t1Sl = hb.t1SL ?? (hb.t1Dir === 'CE' ? (hb.t1Entry - 50) : (hb.t1Entry + 50));
          t1Rows.innerHTML = \`
            <div class="amina-row"><span class="lbl">Direction</span><span class="val \${hb.t1Dir === 'CE' ? 'green' : 'red'}">\${hb.t1Dir}</span></div>
            <div class="amina-row"><span class="lbl">Entry</span><span class="val">\${hb.t1Entry?.toFixed(0) ?? '—'}</span></div>
            <div class="amina-row"><span class="lbl">SL</span><span class="val red">\${t1Sl?.toFixed(0) ?? '—'} (−50 pts)</span></div>
            <div class="amina-row"><span class="lbl">Breakout Level</span><span class="val cyan">\${hb.t1BreakLevel?.toFixed(0) ?? '—'}</span></div>
            <div class="amina-row"><span class="lbl">Rule</span><span class="val yellow">\${hb.t1Rule ? 'Rule ' + hb.t1Rule : '—'}</span></div>
            <div class="amina-row"><span class="lbl">P&L (pts)</span><span class="val \${clr(hb.t1Pts)}">\${fmt(hb.t1Pts)}</span></div>
          \`;
        } else if (isAmina) {
          t1Rows.innerHTML = '<div style="color:#8b949e;font-size:0.82rem">Scanning for entry...</div>';
        } else {
          t1Rows.innerHTML = '<div style="color:#8b949e;font-size:0.82rem">—</div>';
        }

        // ── Amina Re-entry panel ─────────────────────────────────────
        const reRows = document.getElementById('re-rows');
        if (isAmina && hb.reDir) {
          const reSl = hb.reSL ?? (hb.reDir === 'CE' ? (hb.reEntry - 100) : (hb.reEntry + 100));
          reRows.innerHTML = \`
            <div class="amina-row"><span class="lbl">Direction</span><span class="val \${hb.reDir === 'CE' ? 'green' : 'red'}">\${hb.reDir}</span></div>
            <div class="amina-row"><span class="lbl">Entry</span><span class="val">\${hb.reEntry?.toFixed(0) ?? '—'}</span></div>
            <div class="amina-row"><span class="lbl">SL</span><span class="val red">\${reSl?.toFixed(0) ?? '—'} (−100 pts)</span></div>
            <div class="amina-row"><span class="lbl">Symbol</span><span class="val">\${hb.reSymbol ?? '—'}</span></div>
            <div class="amina-row"><span class="lbl">P&L (pts)</span><span class="val \${clr(hb.rePts)}">\${fmt(hb.rePts)}</span></div>
          \`;
        } else if (isAmina && hb.t1Dir) {
          reRows.innerHTML = '<div style="color:#8b949e;font-size:0.82rem">Waiting (T1 SL not hit yet)</div>';
        } else {
          reRows.innerHTML = '<div style="color:#8b949e;font-size:0.82rem">—</div>';
        }

        // ── Trades table ─────────────────────────────────────────────
        const tbody = document.getElementById('trades-tbody');
        if (!d.recentTrades.length) {
          tbody.innerHTML = '<tr><td colspan="7" style="color:#8b949e;text-align:center;padding:20px">No trades yet today</td></tr>';
        } else {
          tbody.innerHTML = d.recentTrades.map((t: any) => {
            const pnl    = t.pnl ?? 0;
            const pnlCls = clr(pnl);
            const time   = t.date ? new Date(t.date).toLocaleTimeString('en-IN', { timeZone: 'Asia/Kolkata' }) : '—';
            const dir    = t.direction === 'CE'
              ? '<span class="badge badge-ce">CE</span>'
              : '<span class="badge badge-pe">PE</span>';
            return \`<tr>
              <td>\${time}</td>
              <td>\${t.type ?? '—'}</td>
              <td>\${dir}</td>
              <td>\${t.entryPrice ?? '—'}</td>
              <td>\${t.exitPrice ?? '—'}</td>
              <td class="\${pnlCls}">\${pnl >= 0 ? '+' : ''}\${pnl.toFixed(0)}</td>
              <td>\${t.reasonExit ?? '—'}</td>
            </tr>\`;
          }).join('');
        }

      } catch(e) {
        document.getElementById('clock').textContent = 'Connection error — retrying...';
      }
    }
    refresh();
    setInterval(refresh, 3000);
  </script>
</body>
</html>`);
});

app.listen(PORT, () => {
  console.log(`\n🌐 Dashboard running at http://localhost:${PORT}`);
  console.log("   Open in browser while the bot is running.");
  console.log("   Auto-refreshes every 3 seconds.\n");
});
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BANKNIFTY Bot Dashboard</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', sans-serif; background: #0d1117; color: #e6edf3; min-height: 100vh; }
    header { background: #161b22; padding: 16px 28px; border-bottom: 1px solid #30363d; display: flex; align-items: center; justify-content: space-between; }
    header h1 { font-size: 1.2rem; font-weight: 600; letter-spacing: 1px; }
    #clock { font-size: 0.85rem; color: #8b949e; }
    #status-dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: #3fb950; margin-right: 8px; animation: pulse 1.5s infinite; }
    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.4} }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; padding: 24px 28px 0; }
    .card { background: #161b22; border: 1px solid #30363d; border-radius: 8px; padding: 18px 20px; }
    .card-label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 1px; color: #8b949e; margin-bottom: 6px; }
    .card-value { font-size: 1.7rem; font-weight: 700; }
    .green { color: #3fb950; }
    .red   { color: #f85149; }
    .gray  { color: #8b949e; }
    .yellow{ color: #e3b341; }
    section { padding: 24px 28px; }
    section h2 { font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px; color: #8b949e; margin-bottom: 14px; }
    table { width: 100%; border-collapse: collapse; font-size: 0.82rem; }
    th { text-align: left; padding: 8px 10px; background: #161b22; color: #8b949e; border-bottom: 1px solid #30363d; font-weight: 500; }
    td { padding: 8px 10px; border-bottom: 1px solid #21262d; }
    tr:last-child td { border-bottom: none; }
    .badge { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 0.72rem; font-weight: 600; }
    .badge-ce  { background: #1f4620; color: #3fb950; }
    .badge-pe  { background: #3d1616; color: #f85149; }
    .badge-flat{ background: #1c2128; color: #8b949e; }
    #position-box { background: #161b22; border: 1px solid #30363d; border-radius: 8px; padding: 20px 24px; margin: 0 28px 24px; }
    #position-box h2 { font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px; color: #8b949e; margin-bottom: 14px; }
    .pos-row { display: flex; gap: 40px; flex-wrap: wrap; }
    .pos-field label { font-size: 0.72rem; color: #8b949e; text-transform: uppercase; }
    .pos-field span  { font-size: 1rem; font-weight: 600; }
    footer { text-align: center; padding: 24px; color: #30363d; font-size: 0.75rem; }
  </style>
</head>
<body>
  <header>
    <h1><span id="status-dot"></span>BANKNIFTY Bot Dashboard</h1>
    <span id="clock">—</span>
  </header>

  <div class="grid">
    <div class="card"><div class="card-label">Daily PnL (pts)</div><div class="card-value" id="pnl">—</div></div>
    <div class="card"><div class="card-label">Trades Today</div><div class="card-value" id="tradeCount">—</div></div>
    <div class="card"><div class="card-label">Wins</div><div class="card-value green" id="wins">—</div></div>
    <div class="card"><div class="card-label">Losses</div><div class="card-value red" id="losses">—</div></div>
    <div class="card"><div class="card-label">Max Drawdown</div><div class="card-value yellow" id="maxdd">—</div></div>
  </div>

  <section>
    <div id="position-box">
      <h2>Active Position</h2>
      <div class="pos-row" id="pos-detail">
        <div class="badge badge-flat">FLAT — No open position</div>
      </div>
    </div>
  </section>

  <section>
    <h2>Today's Trades</h2>
    <table>
      <thead>
        <tr>
          <th>Time (IST)</th><th>Type</th><th>Dir</th>
          <th>Entry</th><th>Exit</th><th>PnL</th>
          <th>Exit Reason</th><th>AI Score</th>
        </tr>
      </thead>
      <tbody id="trades-tbody">
        <tr><td colspan="8" style="color:#8b949e;text-align:center;padding:24px">No trades yet today</td></tr>
      </tbody>
    </table>
  </section>

  <footer>Auto-refreshes every 3 seconds &nbsp;·&nbsp; Data from trades.json &amp; trade-state.json</footer>

  <script>
    async function refresh() {
      try {
        const r = await fetch('/api/status');
        const d = await r.json();
        document.getElementById('clock').textContent = d.timestamp;

        const s = d.todaySummary;
        const pnl = s.totalPnl;
        const pnlEl = document.getElementById('pnl');
        pnlEl.textContent = (pnl >= 0 ? '+' : '') + pnl.toFixed(0);
        pnlEl.className = 'card-value ' + (pnl > 0 ? 'green' : pnl < 0 ? 'red' : 'gray');
        document.getElementById('tradeCount').textContent = s.trades;
        document.getElementById('wins').textContent = s.wins;
        document.getElementById('losses').textContent = s.losses;
        document.getElementById('maxdd').textContent = '-' + s.maxDD.toFixed(0);

        // Active position
        const st = d.activeState;
        const posBox = document.getElementById('pos-detail');
        if (st && (st.earlyEntryDone || st.mainEntryDone) && st.tradeDirection) {
          posBox.innerHTML = \`
            <div class="pos-field"><label>Symbol</label><br><span>\${st.tradeSymbol || '—'}</span></div>
            <div class="pos-field"><label>Direction</label><br><span class="\${st.tradeDirection === 'CE' ? 'green' : 'red'}">\${st.tradeDirection}</span></div>
            <div class="pos-field"><label>Entry ₹</label><br><span>\${st.entryPrice}</span></div>
            <div class="pos-field"><label>Daily PnL (pts)</label><br><span class="\${st.dailyPnL >= 0 ? 'green' : 'red'}">\${st.dailyPnL >= 0 ? '+' : ''}\${(st.dailyPnL ?? 0).toFixed(0)}</span></div>
            <div class="pos-field"><label>Trade #</label><br><span>\${st.tradeCount}</span></div>
            <div class="pos-field"><label>AI Score</label><br><span class="yellow">\${(st.tradeAIScore ?? 0).toFixed(2)}</span></div>
          \`;
        } else {
          posBox.innerHTML = '<div class="badge badge-flat">FLAT — No open position</div>';
        }

        // Trades table
        const tbody = document.getElementById('trades-tbody');
        if (!d.recentTrades.length) {
          tbody.innerHTML = '<tr><td colspan="8" style="color:#8b949e;text-align:center;padding:24px">No trades yet today</td></tr>';
        } else {
          tbody.innerHTML = d.recentTrades.map(t => {
            const pnl = t.pnl ?? 0;
            const pnlCls = pnl > 0 ? 'green' : pnl < 0 ? 'red' : '';
            const time = t.date ? new Date(t.date).toLocaleTimeString('en-IN', { timeZone: 'Asia/Kolkata' }) : '—';
            const dir = t.direction === 'CE'
              ? '<span class="badge badge-ce">CE</span>'
              : '<span class="badge badge-pe">PE</span>';
            return \`<tr>
              <td>\${time}</td>
              <td>\${t.type || '—'}</td>
              <td>\${dir}</td>
              <td>\${t.entryPrice ?? '—'}</td>
              <td>\${t.exitPrice ?? '—'}</td>
              <td class="\${pnlCls}">\${pnl >= 0 ? '+' : ''}\${pnl.toFixed(0)}</td>
              <td>\${t.reasonExit || '—'}</td>
              <td>\${(t.aiScore ?? 0).toFixed(2)}</td>
            </tr>\`;
          }).join('');
        }
      } catch(e) {
        document.getElementById('clock').textContent = 'Connection error — retrying...';
      }
    }
    refresh();
    setInterval(refresh, 3000);
  </script>
</body>
</html>`);
});

app.listen(PORT, () => {
  console.log(`\n🌐 Dashboard running at http://localhost:${PORT}`);
  console.log("   Open in browser while the bot is running.");
  console.log("   Auto-refreshes every 3 seconds.\n");
});
