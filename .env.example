# Application
PORT=4000
APP_URL=http://localhost:4000
SESSION_SECRET=replace-with-a-long-random-value
ADMIN_EMAIL=

# Zerodha login secrets used only by auto_token.js. Keep real values in the VPS .env (mode 0600).
ZERODHA_USER_ID=
ZERODHA_PASSWORD=
ZERODHA_TOTP_SECRET=

# Google authentication
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_EMAIL=

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
FAST2SMS_API_KEY=

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Trading bot integration
INTERNAL_BOT_SECRET=
TRADING_BOT_DIR=/home/ubuntu/trading-bot
TRADING_BOT_ENV_PATH=/home/ubuntu/trading-bot/.env
STOCK_ALERTS_DIR=/home/ubuntu/trading-bot
