{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": ".",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmitOnError": false
  },
  "include": [
    "src/**/*",
    "token-server.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/backtest.ts",
    "src/server.ts"
  ]
}