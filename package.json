{
  "name": "zeroscreen",
  "version": "1.0.0",
  "description": "Self-hosted NSE stock screener",
  "main": "src/server.ts",
  "scripts": {
    "dev": "ts-node-dev --respawn src/server.ts",
    "start": "ts-node src/server.ts",
    "build": "tsc",
    "seed": "ts-node src/scheduler.ts --seed",
    "repo:inventory": "node scripts/repo-inventory.js",
    "repo:verify-structure": "node scripts/verify-structure.js",
    "repo:verify-structure:strict": "node scripts/verify-structure.js --strict",
    "repo:scan-check-risk": "node scripts/scan-root-check-risk.js",
    "repo:scan-check-py-risk": "node scripts/scan-root-check-py-risk.js",
    "repo:scan-backtest-risk": "node scripts/scan-root-backtest-risk.js",
    "repo:scan-utility-js-risk": "node scripts/scan-root-utility-js-risk.js",
    "repo:migrate-with-wrapper": "node scripts/migrate-with-wrapper.js",
    "repo:migrate-py-with-wrapper": "node scripts/migrate-py-with-wrapper.js",
    "repo:patch-utility-js-paths": "node scripts/patch-utility-js-paths.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-sqlite3": "^0.9.16",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-session": "^1.19.0",
    "kiteconnect": "^5.3.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.7",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/node": "^20.11.25",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/sqlite3": "^3.1.11",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.2"
  }
}
