/**
 * launcher.ts — Unified entry point
 *
 * Runs token-server, paper-trade-engine, and trading-bot in a single
 * Node.js process instead of 3 separate PM2 processes.
 *
 * Saves ~60 MB RAM (2 fewer V8 process overheads).
 *
 * Import order matters:
 *   1. token-server  — Express server starts (port 3000), non-blocking
 *   2. paper-trade-engine — async while-loop daemon starts, non-blocking
 *   3. Strategy bot  — AMINA (default) or legacy index.ts
 */

import { config } from './config';

// 1. Kite OAuth token refresh server (port 3000)
import '../token-server';

// 2. Paper trade engine — triggers at 7:36 PM IST on weekdays
import './paper-trade-engine';

// 3. Strategy bot — AMINA runs standalone; all other strategies use index.ts
if ((config.activeStrategy as string) === 'AMINA') {
  // Amina strategy — Rs 10,66,085 over 5 years
  import('./amina-live').then(m => m.startAmina()).catch(e => {
    console.error('[AMINA] Failed to start:', e);
    process.exit(1);
  });
} else {
  // Legacy strategies: BODY_BREAKOUT, RC_CONFIRM, ITM_HOLD, HYBRID_REVERSE
  import('./index');
}
